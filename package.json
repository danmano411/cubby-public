{
  "name": "cubby",
  "productName": "Cubby",
  "version": "0.1.5",
  "private": true,
  "description": "A grouped app tray and window switcher for Windows and macOS",
  "license": "MIT",
  "author": "Cubby contributors",
  "homepage": "https://github.com/danmano411/cubby-public",
  "repository": {
    "type": "git",
    "url": "https://github.com/danmano411/cubby-public.git"
  },
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "check": "node --test test/*.test.js native/mac-helper/test/adapter.test.js",
    "smoke": "electron . --smoke",
    "icon": "electron scripts/render-icon.js",
    "package": "electron-builder --dir",
    "dist": "electron-builder --publish never",
    "privacy": "node scripts/privacy-check.mjs ."
  },
  "build": {
    "appId": "app.cubby.desktop",
    "productName": "Cubby",
    "copyright": "Copyright (c) 2026 Cubby contributors",
    "asar": false,
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!**/*.test.js"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Cubby-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "Cubby",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.utilities",
      "identity": null,
      "files": [
        "src/**/*",
        "package.json",
        "!**/*.test.js",
        "!node_modules/koffi/**",
        "!node_modules/@koromix/**"
      ],
      "extraResources": [
        {
          "from": "native/mac-helper/.build/apple/Products/Release/cubby-helper",
          "to": "cubby-helper"
        }
      ],
      "artifactName": "Cubby-${version}-universal.${ext}",
      "extendInfo": {
        "LSUIElement": true,
        "NSMicrophoneUsageDescription": "Cubby listens for your voice commands only when you turn voice on. Recognition runs on this Mac.",
        "NSSpeechRecognitionUsageDescription": "Cubby uses on-device speech recognition for its optional voice commands.",
        "NSAppleEventsUsageDescription": "Cubby asks your music player what is playing and sends it play, pause and skip."
      },
      "x64ArchFiles": "Contents/Resources/cubby-helper"
    },
    "dmg": {
      "title": "Cubby ${version}"
    }
  },
  "dependencies": {
    "koffi": "^3.3.2"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  }
}
